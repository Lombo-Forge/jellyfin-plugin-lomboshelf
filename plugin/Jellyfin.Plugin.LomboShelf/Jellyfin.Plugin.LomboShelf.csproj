<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.LomboShelf</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.LomboShelf</AssemblyName>
    <Version>0.1.1.0</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin.Controller 12.4.0 targets net10.0 (checked in its nuspec). -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" LogicalName="Jellyfin.Plugin.LomboShelf.Configuration.configPage.html" />
    <!-- The web files of this repository, embedded under web/<file>. -->
    <EmbeddedResource Include="..\..\web\*.js;..\..\web\*.css" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
